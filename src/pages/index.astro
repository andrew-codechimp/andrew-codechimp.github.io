---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { PORTFOLIO_CATEGORIES } from '../consts/portfolioCategories';

const allPortfolio = await getCollection('portfolio').then(items =>
	items.filter(item => !item.data.exclude)
);

// Pre-render all portfolio items
const renderedItems = await Promise.all(
	allPortfolio.map(async (item) => ({
		...item,
		Content: (await render(item)).Content,
	}))
);

// Group portfolio items by category
const portfolioByCategory = new Map();
for (const item of renderedItems) {
	const categoryId = item.data.category || 'uncategorized';
	if (!portfolioByCategory.has(categoryId)) {
		portfolioByCategory.set(categoryId, []);
	}
	portfolioByCategory.get(categoryId).push(item);
}

// Sort items within each category by order
portfolioByCategory.forEach((items) => {
	items.sort((a, b) => {
		const orderA = a.data.order ?? 999;
		const orderB = b.data.order ?? 999;
		return orderA - orderB;
	});
});

// Get sorted categories
const sortedCategories = PORTFOLIO_CATEGORIES.filter(cat => portfolioByCategory.has(cat.id));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="portfolio-section">			
				{sortedCategories.map((category) => (
					<div class="category-section">
						<h2 class="category-title">{category.name}</h2>
						<div class="portfolio-grid">
							{portfolioByCategory.get(category.id)?.map((item) => (
								<div class="portfolio-item">
									<PortfolioCard item={item}>
										<item.Content />
									</PortfolioCard>
								</div>
							))}
						</div>
					</div>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 100%;
		max-width: 100%;
		box-sizing: border-box;
		padding-top: 1rem;
	}

	.portfolio-section {
		padding: 0.75rem 1rem 2rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	h1 {
		font-size: 2.5rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		text-align: center;
	}

	.intro-text {
		text-align: center;
		font-size: 1.1rem;
		color: var(--text-secondary, #666);
		margin-bottom: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.portfolio-page-label {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 200;
		line-height: 1.2;
	}

	.category-section {
		margin-bottom: 3rem;
	}

	.category-title {
		font-size: 1.6rem;
		font-weight: 500;
		margin-bottom: 0.5rem;
		margin-top: 2rem;
		padding-bottom: 0.5rem;
	}

	.portfolio-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.5rem;
		margin-top: 1.5rem;
		min-width: 0;
	}

	.portfolio-item {
		display: flex;
		min-width: 0;
	}

	.portfolio-item > * {
		width: 100%;
		min-width: 0;
	}

	@media (max-width: 768px) {
		main {
			padding: 0.5rem 0.5rem 1rem;
		}

		.portfolio-section {
			padding: 0.5rem 0.25rem 1rem;
		}

		h1 {
			font-size: 2rem;
		}

		.category-title {
			font-size: 1.4rem;
		}

		.portfolio-page-label {
			font-size: 1.4rem;
		}

		.portfolio-grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
